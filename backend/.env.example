# ==============================================================================
# YOIBI Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in development.
# In production (e.g. Railway), configure these variables in the service dashboard.
# NEVER commit .env or real credentials to Git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# Node runtime mode: development | production | test
NODE_ENV=development

# HTTP & WebSocket listening port (Railway/PaaS assigns this automatically via $PORT)
PORT=5000

# Bind host (0.0.0.0 is mandatory for containerized deployments and Railway)
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Server-Only Secret)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas cluster connection string)
# Required in production.
MONGODB_URI=mongodb://localhost:27017/yoibi

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT VERIFICATION (Server-Only Secret)
# ------------------------------------------------------------------------------
# Origin URL of the Next.js / Better Auth frontend service
# Used for server-to-server admin calls and default JWKS endpoint derivation
BETTER_AUTH_BASE_URL=http://localhost:3000

# Shared cryptographic secret matching Better Auth in the frontend
# Used for validating HMAC-signed admin API calls and HS256/JWT fallback tokens
BETTER_AUTH_SECRET=replace_with_secure_random_32_character_secret

# Optional: Explicit remote JWKS endpoint for asymmetric JWT verification
# If omitted or empty, automatically resolves to ${BETTER_AUTH_BASE_URL}/api/auth/jwks
# BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# Trusted frontend origin URL
FRONTEND_URL=http://localhost:3000

# Allowed CORS origin for Express REST endpoints and Socket.IO connections
# In production, set to your production frontend domain (e.g. https://yoibi.app)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA STORAGE (Server-Only Secret)
# ------------------------------------------------------------------------------
# Cloudinary account credentials for video uploads and media deletions
# CLOUDINARY_API_SECRET is strictly backend-only and must NEVER be shared with browser.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. LIVEKIT REALTIME AUDIO/VIDEO SFU (Server-Only Secret)
# ------------------------------------------------------------------------------
# LiveKit SFU credentials for live broadcast streams and collaborative meet-up rooms
# LIVEKIT_API_SECRET is strictly backend-only and must NEVER be shared with browser.
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
