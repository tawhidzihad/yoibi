# ==============================================================================
# YOIBI Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local (or .env) in development.
# In production (e.g. Vercel), configure these variables in the project settings.
# NEVER commit .env or real credentials to Git history.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE / PUBLIC CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# These variables are exposed to the browser client bundle via Next.js NEXT_PUBLIC_ prefix.
# ONLY put non-sensitive origins and URLs here. NEVER put secrets with NEXT_PUBLIC_.

# Base REST API URL for communicating with the YOIBI Express backend
# Local Dev: http://localhost:5000/api/v1
# Production: https://api.yourdomain.com/api/v1 (or Railway public URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Base URL for Better Auth authentication client and server endpoints
# Local Dev: http://localhost:3000
# Production: https://yourdomain.com (your Vercel public domain)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional WebSocket URL override for Socket.IO realtime events.
# If omitted or empty, the frontend automatically derives it from NEXT_PUBLIC_API_BASE_URL origin.
# Local Dev: http://localhost:5000 (or leave commented)
# Production: https://api.yourdomain.com (or leave commented)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. NEXT.JS SERVER-ONLY CONFIGURATION (NEVER EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
# These variables are consumed strictly within the Next.js server runtime (API routes
# and Better Auth server handler in frontend/src/lib/auth.js).

# Cryptographic signing secret for Better Auth sessions and JWT token issuance.
# MUST match the BETTER_AUTH_SECRET configured in the backend environment.
# Generate a secure 32+ character random string (e.g., `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace_with_secure_random_32_character_secret

# Optional: Google OAuth 2.0 Client Credentials for Social Sign-In
# Leave empty or omitted if Google authentication is not enabled.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# NOTE: There are NO transactional email variables (e.g. RESEND_API_KEY,
# EMAIL_FROM). Email verification and password reset are removed from YOIBI -
# authentication is ONLY email + password (no verification) and Google OAuth.
